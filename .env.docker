# Configuration Docker pour Laravel 12 - ShowMe
# Ce fichier contient les variables d'environnement pour Docker Compose

# Configuration de l'application
APP_NAME=ShowMe
APP_ENV=local
APP_KEY=base64:bnBWEKNkEY4B7ko5cBIDh7qiyoF8D6XMNJUNBPnY+JQ=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Ports externes
APP_PORT=8000
VITE_PORT=5173
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025
DB_PORT_EXTERNAL=3306
REDIS_PORT_EXTERNAL=6379

# Configuration utilisateur (adapter selon votre système)
USER_ID=1000
GROUP_ID=1000

# Base de données PostgreSQL
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=showme
DB_USERNAME=showme
DB_PASSWORD=secret

# Redis
CACHE_STORE=redis
REDIS_HOST=redis
REDIS_PORT=6379
QUEUE_CONNECTION=redis

# Mail (Mailpit pour développement)
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@showme.local"
MAIL_FROM_NAME="${APP_NAME}"

# AWS S3 (optionnel - à configurer si nécessaire)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Session
SESSION_DRIVER=database
SESSION_LIFETIME=120

# Vite
VITE_APP_NAME="${APP_NAME}"
